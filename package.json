{
  "private": true,
  "scripts": {
    "postinstall": "pnpm build:lib",
    "build:lib": "pnpm --filter next-cache-s3 build",
    "dev": "pnpm --filter example-basic dev",
    "build": "pnpm --filter example-basic build",
    "start": "pnpm --filter example-basic start",
    "typecheck": "tsc && pnpm -r typecheck",
    "lint": "eslint",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter next-cache-s3 test:watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check"
  },
  "devDependencies": {
    "@types/node": "25.3.0",
    "eslint": "9.39.3",
    "eslint-config-next": "16.1.6",
    "prettier": "3.10.1",
    "typescript": "5.9.3"
  }
}
